# AWS Region & Credentials (or use ~/.aws/credentials / IAM Roles)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Kinesis Stream Configuration
KINESIS_STREAM_NAME=ecommerce-transaction-stream
KINESIS_BATCH_SIZE=100
KINESIS_MAX_RETRIES=5

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=ecommerce-transactions
DYNAMODB_IDEMPOTENCY_TABLE=ecommerce-idempotency-records

# S3 Storage Configuration
S3_ARCHIVE_BUCKET=ecommerce-streaming-analytics-archive
S3_RAW_PREFIX=raw-events/
S3_PROCESSED_PREFIX=processed-events/
S3_REJECTED_PREFIX=rejected-events/

# CloudWatch Configuration
CLOUDWATCH_METRIC_NAMESPACE=EcommerceStreamingAnalytics
METRIC_ENVIRONMENT=development

# Business Thresholds
FLAGGED_AMOUNT_THRESHOLD=10000.00
DEFAULT_CURRENCY=INR
